# Copy to .env and fill in. Never commit .env.

APP_TIMEZONE=UTC

# --- Storage -------------------------------------------------------------
# sqlite (zero setup, file created automatically) or mysql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# For MySQL / MariaDB instead:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=invoice_generator
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password

# --- Email ---------------------------------------------------------------
# log  = write emails to storage/mail/*.eml (no delivery, no credentials needed)
# smtp = deliver through any SMTP provider (Mailtrap, Brevo, Gmail app password, ...)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME="Invoice Studio"

SMTP_HOST=smtp.example.com
# 587 + tls (STARTTLS) or 465 + ssl
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# Optional: CA bundle path if PHP can't verify certificates (common on Windows)
SMTP_CA_FILE=

# Optional safety net: only allow these recipients (comma separated; "@domain" allows a whole domain).
# Leave empty to allow any address.
MAIL_ALLOWED_RECIPIENTS=
